// Run in the existing ShowDown workspace. Confirm app name for your environment.
let events = ContainerAppConsoleLogs_CL
| where TimeGenerated > ago(24h)
| where ContainerAppName_s == "asm-core"
| extend m=parse_json(Log_s)
| where m.schema == "showdown.monitor.v1";
// Completion events count attempts with committed terminal results; duration excludes queue wait.
events
| where m.event in ("scan_completed", "scan_failed")
| summarize successes=countif(m.event == "scan_completed"), failures=countif(m.event == "scan_failed"), p95_seconds=percentile(todouble(m.duration_ms)/1000,95) by bin(TimeGenerated,1h)
| order by TimeGenerated asc

